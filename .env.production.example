# ═══════════════════════════════════════════════════════════════════════
# 生产部署配置模板（服务器上的 .env）
#
#   本地准备：cp .env.production.example .env.production   # 填好真实值
#   首次部署：./deploy/publish.sh user@1.2.3.4 --config
#             （--config 传的是本地 .env；首次部署也可以手动把本文件放到
#               服务器 /opt/gym/.env，改名为 .env）
#
# 与 .env.example（开发模板）的区别只有三类：
#   1. GYM_LOCAL=0        关掉固定测试账号，微信登录必须真调 jscode2session
#   2. WX_SECRET 必填     否则所有用户都登不上，接口会返回「微信登录失败」
#   3. 所有口令换成真值    且不能与开发机相同
#
# 这个文件可以提交到仓库，真实的 .env 永远不要提交。
# ═══════════════════════════════════════════════════════════════════════

# ── 数据库 ────────────────────────────────────────────────────────────
# 容器部署时 MYSQL_DSN 由 docker-compose.yml 用 ${MYSQL_PASSWORD} 覆盖成
# tcp(mysql:3306)，这里这一行不会被用到；保留是为了兼容"服务器上直接跑二进制"的部署方式
MYSQL_PASSWORD=__CHANGE_ME_强口令A__
MYSQL_ROOT_PASSWORD=__CHANGE_ME_强口令B__
MYSQL_DSN=gym:__CHANGE_ME_强口令A__@tcp(127.0.0.1:3306)/gym?charset=utf8mb4&parseTime=true&loc=UTC

# ── 会话 ──────────────────────────────────────────────────────────────
# 生成方式：openssl rand -base64 48
# 必须与开发机上的值不同；少于 32 字节进程会直接退出
SESSION_SECRET=__CHANGE_ME_openssl_rand_base64_48__

# ── 后台账号 ──────────────────────────────────────────────────────────
# 服务每次启动都会用这里的值覆盖库里的哈希，所以改密码＝改这里再重启
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=__CHANGE_ME_后台管理员强口令__
OPERATOR_ACCOUNT=operator
OPERATOR_PASSWORD=__CHANGE_ME_运营员强口令__

# ── 微信 ──────────────────────────────────────────────────────────────
WX_APP_ID=wx937da8e91caefe9e
# 必填。微信公众平台 → 开发管理 → 开发设置 → AppSecret
WX_SECRET=__CHANGE_ME_小程序_AppSecret__
# 生产环境必须为 0：否则没配密钥时会退化成固定测试账号，等于任何人都是同一个用户
GYM_LOCAL=0
# 生产环境留空
WX_MOCK_OPENID=

# ── 监听地址 ──────────────────────────────────────────────────────────
# 容器内固定 18080，由 nginx 反代；不要改成 127.0.0.1
LISTEN_ADDR=:18080

# ── 微信虚拟支付 ──────────────────────────────────────────────────────
XPAY_OFFER=
XPAY_KEY=
# 档位商品 ID 建议在后台「会员套餐」里维护，这里只做兜底
XPAY_PRODUCT_7=
XPAY_PRODUCT_30=
XPAY_PRODUCT_365=

# ── 微信消息推送 ──────────────────────────────────────────────────────
WX_PUSH_TOKEN=
WX_PUSH_AES=

# ═══════════════════════════════════════════════════════════════════════
# 本地开发配置模板
#
#   cp .env.example .env     # 之后只改 .env，不要改这个模板
#   cd apps/backend && go run ./cmd/api
#
# .env 已在 .gitignore 里，不会提交；配置只在进程启动时读一次，改完要重启。
# 部署到服务器请用另一份模板：.env.production.example
# ═══════════════════════════════════════════════════════════════════════

# ── 数据库 ────────────────────────────────────────────────────────────
# 本机 MySQL（Homebrew 默认 127.0.0.1:3306），按自己的账号口令改
MYSQL_PASSWORD=gymdev123
# 只给 deploy/docker-compose.yml 里的 mysql 容器初始化 root 用，本地 go run 不读
MYSQL_ROOT_PASSWORD=gymdev123
# 宿主机 go run 用这一行；进容器后由 compose 覆盖成服务名 mysql:3306
MYSQL_DSN=gym:gymdev123@tcp(127.0.0.1:3306)/gym?charset=utf8mb4&parseTime=true&loc=UTC

# ── 会话 ──────────────────────────────────────────────────────────────
# JWT 签名密钥，至少 32 字节。改这个值等于让所有已登录用户立刻下线
SESSION_SECRET=local-dev-session-secret-change-me-32bytes

# ── 后台账号（启动时自动创建/更新，改这里即可重置密码）────────────────
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=admin123456
OPERATOR_ACCOUNT=operator
OPERATOR_PASSWORD=operator123456

# ── 微信 ──────────────────────────────────────────────────────────────
WX_APP_ID=wx937da8e91caefe9e
# 小程序密钥：微信公众平台 → 开发管理 → 开发设置 → AppSecret（重置后只显示一次）
WX_SECRET=
# 本地不配 WX_SECRET 时用固定测试账号 local_dev_user 登录；填任意值可模拟另一个用户
WX_MOCK_OPENID=
# 1 = 本地模式：没配 WX_SECRET 时退化成固定测试账号。生产环境必须为 0
GYM_LOCAL=1

# ── 监听地址 ──────────────────────────────────────────────────────────
# 留空默认 :18080（0.0.0.0:18080，局域网内手机可以访问，真机调试靠这个）
# 改成 127.0.0.1:18080 之后，手机扫码就再也连不上开发机了
LISTEN_ADDR=:18080

# ── 微信虚拟支付（不接支付可整段留空）────────────────────────────────
XPAY_OFFER=
XPAY_KEY=
# 商品 ID 兜底：档位可在后台「会员套餐」里直接填，填了就用库里的；
# 留空才读这几行，新增档位不必改这里、也不用重启
XPAY_PRODUCT_7=
XPAY_PRODUCT_30=
XPAY_PRODUCT_365=

# ── 微信消息推送（可选）──────────────────────────────────────────────
WX_PUSH_TOKEN=
WX_PUSH_AES=

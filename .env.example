MYSQL_PASSWORD=
# 只给 deploy/docker-compose.yml 里的 mysql 容器初始化 root 用
MYSQL_ROOT_PASSWORD=
# 宿主机 go run 用这一行；进容器后由 compose 覆盖成服务名 mysql:3306
MYSQL_DSN=gym:your-password@tcp(127.0.0.1:3306)/gym?charset=utf8mb4&parseTime=true&loc=UTC
SESSION_SECRET=
ADMIN_ACCOUNT=
ADMIN_PASSWORD=
WX_APP_ID=
WX_SECRET=
XPAY_OFFER=
XPAY_KEY=
XPAY_PRODUCT_7=
XPAY_PRODUCT_30=
XPAY_PRODUCT_365=
WX_PUSH_TOKEN=
WX_PUSH_AES=
GYM_LOCAL=0
OPERATOR_ACCOUNT=
OPERATOR_PASSWORD=
